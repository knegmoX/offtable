#!/usr/bin/env bash
# 低优先级执行（共享 / 小规格机器上编译不抢占其他服务）：CPU 上限 200% + nice + ionice。
# 用法：scripts/lp <命令...>
set -euo pipefail
if command -v systemd-run >/dev/null && systemd-run --user --scope -q -p CPUQuota=200% true 2>/dev/null; then
  exec systemd-run --user --scope -q -p CPUQuota=200% nice -n19 ionice -c3 "$@"
fi
exec nice -n19 ionice -c3 "$@"
